{
  "name": "fittrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "db:seed": "npx tsx scripts/seed.ts",
    "icons:build": "node scripts/build-icons.mjs",
    "dev-loop": "bash scripts/dev-loop.sh",
    "typecheck": "tsc --noEmit",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "theme:build": "npm run astryx -- theme build src/lib/fittrack-theme.ts -o src/lib/generated/fittrack-neutral/theme.css",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "echo 'e2e is DISABLED \u2014 the suite is red (42+ pre-existing failures). No specs ran. Use `npm run test:e2e:run` to run it anyway.'",
    "test:e2e:run": "npx playwright test --project=chromium --project=pixel-7",
    "test:watch": "vitest watch",
    "test:e2e:webkit": "docker run --rm --network host -v \"$PWD\":/work -w /work -e CI=1 mcr.microsoft.com/playwright:v1.62.0-noble npx playwright test --project=iphone-14",
    "lint": "oxlint src/ tests/ scripts/",
    "lint:fix": "oxlint --fix src/ tests/ scripts/",
    "format": "oxfmt --write src/ tests/ scripts/",
    "format:check": "oxfmt --check src/ tests/ scripts/",
    "prepare": "lefthook install",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio",
    "db:generate": "npx drizzle-kit generate",
    "test:e2e:dev-smoke": "E2E_WEB_SERVER_COMMAND='npm run dev' E2E_REUSE_SERVER=false npx playwright test --project=dev-runtime"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.1.8",
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "ultracite": "^7.9.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
