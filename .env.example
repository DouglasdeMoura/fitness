# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Web Push (VAPID) ---
# Generate with:  npx web-push generate-vapid-keys --json
#
# VAPID_PUBLIC_KEY is served to the browser and used to create push
# subscriptions. VAPID_PRIVATE_KEY signs outgoing pushes and must stay
# server-side only.
#
# Rotating these invalidates every existing push subscription, so subscribers
# have to re-subscribe. Treat them as long-lived.
#
# When VAPID_PUBLIC_KEY is absent the app must render a "push not configured"
# state rather than throwing — the app has to work without push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI sent with push requests so the push service can reach you about
# problematic traffic. mailto: or https: only.
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduled notification delivery (issue #67) ---
# Only needed if scheduled reminders are triggered by an external cron hitting
# an HTTP endpoint. Shared secret so the endpoint is not publicly invocable.
SCHEDULER_SECRET=

# --- Better Auth (issue #42) ---
# Secret for signing session cookies. Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Public URL of the app (e.g. http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# Demo account password for `scripts/seed.ts` (required when NODE_ENV=production)
SEED_DEMO_PASSWORD=

# GitHub OAuth (optional — social sign-in is disabled when either is unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
